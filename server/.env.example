PORT=3000
NODE_ENV=development
MONGODB_LOCAL_DB=mongodb://localhost:27017/voting_app

SESSION_SECRET=replace-with-long-session-secret
COOKIE_SECRET=replace-with-long-cookie-secret
JWT_ACCESS_SECRET=replace-with-long-access-secret
JWT_REFRESH_SECRET=replace-with-long-refresh-secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SESSION_TTL_MS=86400000
REFRESH_TTL_SECONDS=604800

CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

BCRYPT_ROUNDS=12
CANDIDATE_PAGE_SIZE=10
